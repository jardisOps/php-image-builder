# shellcheck shell=dash
# shellcheck disable=SC2034  # die drei Listen unten werden vom sourcenden Dockerfile gelesen, nicht hier
# ---------------------------------------------------------------------------
# php-extensions.env — die eine Extension-Definition (A2.2)
# ---------------------------------------------------------------------------
# Wird gesourct, nicht ausgefuehrt. Zwei Konsumenten lesen dieselbe Datei und
# verhindern damit die Drift, die im Bestand zwischen phpcli und phpfpm entstand
# (dort war die Liste in beiden Dockerfiles getrennt gepflegt — D1: pcntl fehlte
# in phpfpm, D2: redis hiess dort anders):
#
#   src/base/Dockerfile        docker-php-ext-install / pecl install
#   src/frankenphp/Dockerfile  install-php-extensions (P7)
#
# Beide Werkzeuge nehmen dieselbe Schreibweise `name-version` fuer gepinnte
# PECL-Extensions — deshalb genuegt EINE Liste fuer beide.
#
# Die Versionen selbst stehen nicht hier, sondern in ../../.env (A2.1). Sie
# kommen als Build-ARG in die Bauumgebung und werden beim Sourcen eingesetzt.
# ---------------------------------------------------------------------------

# A2.4 — kein Versions-Default. Fehlt eine Version, bricht der Build hier ab,
# statt still eine andere Version zu bauen als die .env pflegt. Genau dieser
# Defekt steckte im Bestand: phpcli/src/Dockerfile:22 trug
# `ARG COMPOSER_VERSION=2.9.3`, waehrend die .env 2.9.5 pflegte (D16).
EXT_VERSION_HINT='ist nicht gesetzt — die PECL-Versionen kommen als Build-ARG aus der .env. Es gibt bewusst keinen Default, weil ein fehlender Wert sonst still eine andere Version bauen wuerde als die .env pflegt (A2.4).'

: "${APCU_VERSION:?$EXT_VERSION_HINT}" \
  "${REDIS_VERSION:?$EXT_VERSION_HINT}" \
  "${XDEBUG_VERSION:?$EXT_VERSION_HINT}" \
  "${PCOV_VERSION:?$EXT_VERSION_HINT}" \
  "${AMQP_VERSION:?$EXT_VERSION_HINT}" \
  "${RDKAFKA_VERSION:?$EXT_VERSION_HINT}"

# ---------------------------------------------------------------------------
# Nachzubauende PHP-Extensions
# ---------------------------------------------------------------------------
# NUR das, was das offizielle Image nicht schon mitbringt. pcntl kommt nach base
# und damit erstmals auch ins fpm-Target (E5, hebt D1 auf) — es kostet zur
# Laufzeit nichts, das bisherige Weglassen war ein Nutzungs-, kein
# Sicherheitsargument.
#
# GESTRICHEN gegenueber dem Bestand: curl, dom und mbstring. Alle drei sind im
# offiziellen php:X-fpm-alpine bereits statisch einkompiliert — geprueft am
# 2026-07-25 fuer 8.3 UND 8.5, in beiden meldet `php -m` sie ohne unser Zutun,
# und keine der drei erzeugt eine conf.d-INI. Beide Bestands-Dockerfiles bauten
# sie dennoch nach; das Ergebnis wanderte ungenutzt in den Muell.
#
# Der Rueckbau ist nicht nur Aufraeumen: ab PHP 8.5 bricht `dom` den Build, weil
# ext/dom dort einen HTML5-Parser mitbringt, der lexbor voraussetzt
# ("fatal error: lexbor/html/parser.h: No such file or directory"). Statt
# lexbor-dev als Build-Abhaengigkeit nachzuruesten, entfaellt der ueberfluessige
# Bauschritt — dom bleibt vorhanden, es kommt aus dem Basis-Image.
#
# Mit dom entfaellt zugleich die Sonderbehandlung `-j1`: alle verbleibenden
# Extensions bauen parallel.
PHP_EXT_CORE='bcmath exif gd intl mysqli pcntl pdo_mysql pdo_pgsql soap sockets zip'

# ---------------------------------------------------------------------------
# PECL-Extensions, auf die Version aus der .env gepinnt
# ---------------------------------------------------------------------------
PHP_EXT_PECL="apcu-${APCU_VERSION} \
redis-${REDIS_VERSION} \
xdebug-${XDEBUG_VERSION} \
pcov-${PCOV_VERSION} \
amqp-${AMQP_VERSION} \
rdkafka-${RDKAFKA_VERSION}"
