# shellcheck shell=dash
# shellcheck disable=SC2034  # the three lists below are read by the sourcing Dockerfile, not here
# ---------------------------------------------------------------------------
# php-extensions.env - the one extension definition
# ---------------------------------------------------------------------------
# Sourced, not executed. A single consumer reads this file, avoiding drift
# between separately maintained per-target extension lists:
#
#   src/base/Dockerfile        docker-php-ext-install / pecl install
#
# The versions themselves are not listed here but in ../../.env. They arrive
# as a build ARG and are substituted in when this file is sourced.
# ---------------------------------------------------------------------------

# No version fallback: a missing version aborts the build here instead of
# silently building a different version than the .env maintains.
EXT_VERSION_HINT='is not set - PECL versions come as a build ARG from the .env. There is deliberately no default, since a missing value would otherwise silently build a different version than the .env maintains.'

: "${APCU_VERSION:?$EXT_VERSION_HINT}" \
  "${REDIS_VERSION:?$EXT_VERSION_HINT}" \
  "${XDEBUG_VERSION:?$EXT_VERSION_HINT}" \
  "${PCOV_VERSION:?$EXT_VERSION_HINT}" \
  "${AMQP_VERSION:?$EXT_VERSION_HINT}" \
  "${RDKAFKA_VERSION:?$EXT_VERSION_HINT}"

# ---------------------------------------------------------------------------
# PHP extensions to build
# ---------------------------------------------------------------------------
# ONLY what the official image does not already provide. pcntl now comes
# after base, so it is included in the fpm target as well - it costs nothing
# at runtime, and omitting it before was a usage limitation, not a security
# one.
#
# DROPPED versus prior builds: curl, dom, and mbstring. All three are already
# statically compiled into the official php:X-fpm-alpine image; building them
# again produced unused output. From PHP 8.5, building dom would additionally
# break the build (ext/dom's HTML5 parser requires lexbor); dropping the
# redundant build step avoids that dependency, and dom stays available from
# the base image regardless.
#
# Without dom, the special-cased `-j1` also goes away: all remaining
# extensions build in parallel.
PHP_EXT_CORE='bcmath exif gd intl mysqli pcntl pdo_mysql pdo_pgsql soap sockets zip'

# ---------------------------------------------------------------------------
# PECL extensions, pinned to the version from the .env
# ---------------------------------------------------------------------------
PHP_EXT_PECL="apcu-${APCU_VERSION} \
redis-${REDIS_VERSION} \
xdebug-${XDEBUG_VERSION} \
pcov-${PCOV_VERSION} \
amqp-${AMQP_VERSION} \
rdkafka-${RDKAFKA_VERSION}"
