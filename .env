# =============================================================================
# php-image-builder — Single Source of Truth
# =============================================================================
# This file feeds ALL targets (base, cli, fpm) and the demo stack. No value is
# maintained in a second place; in particular, no Dockerfile carries its own
# version default.
#
# Read by:  Makefile (include + export) -> support/docker-bake.hcl -> Dockerfiles
#           docker compose (demo stack)
#
# Quoting: deliberately WITHOUT quotes, because Make would otherwise take the
# value including the quote characters. Values with spaces are quoted only at
# their point of use.
# =============================================================================


# -----------------------------------------------------------------------------
# Repository & Registry
# -----------------------------------------------------------------------------
GITHUB_ORG=jardisOps
GITHUB_REPO=php-image-builder

DOCKER_HUB=headgent
DOCKER_BUILDKIT=1
MAINTAINER_EMAIL=jardisDev@headgent.com

# Published image names. Stay unchanged — the repo name is independent of
# them; consumers must not notice the consolidation.
IMAGE_NAME_CLI=phpcli
IMAGE_NAME_FPM=phpfpm


# -----------------------------------------------------------------------------
# Base images
# -----------------------------------------------------------------------------
ALPINE_VERSION=3.23

# Default PHP version for single builds (make build, make shell). The full
# build matrix lives in support/makefiles/docker.helper.mk (PHP_VERSIONS):
# 8.3 / 8.4 / 8.5, including the PHP_LATEST derivation.
PHP_VERSION=8.3

# nginx for the demo stack. Not a build target — the official image is used
# unchanged.
NGINX_VERSION=1.28

# Database for the demo stack. Also an unchanged official image — this repo
# builds PHP runtimes, not databases, the same boundary as nginx above.
#
# 11.8 is the current LTS line. 11.2, still pinned in some Jardis test
# compose files, is a short-lived series without support and not a template
# to follow.
MARIADB_VERSION=11.8


# -----------------------------------------------------------------------------
# Build tools
# -----------------------------------------------------------------------------
COMPOSER_VERSION=2.9.5

# PECL extensions. Identical across all targets — the extension list itself
# lives in src/shared/php-extensions.env.
APCU_VERSION=5.1.28
REDIS_VERSION=6.3.0
XDEBUG_VERSION=3.5.1
PCOV_VERSION=1.0.12
AMQP_VERSION=2.2.0
RDKAFKA_VERSION=6.0.5

# Optional DB CLI clients, comma-separated: mysql,postgres,sqlite
# Empty = no clients. Applies to all targets starting from base.
INSTALL_DB_CLIENTS=


# -----------------------------------------------------------------------------
# Container user
# -----------------------------------------------------------------------------
# Base UID/GID of appuser, baked into the image. The entrypoint adjusts them
# at runtime to match the owner of /app, so an override is rarely needed. Both
# the Unix user and group are named "appuser" in all targets.
PUID=1000
PGID=1000

APP_ROOT=/app


# =============================================================================
# Runtime defaults
# =============================================================================

# -----------------------------------------------------------------------------
# APP_ENV — the one environment switch
# -----------------------------------------------------------------------------
# Valid values: dev | test | prod
# Sets a consistent profile of Xdebug, PCOV, OPcache, JIT, and error-display
# settings. The profile table lives in exactly one place:
# src/shared/entrypoint/lib-phpini.sh.
#
# PRECEDENCE RULE:
#   explicitly set variable  >  APP_ENV profile  >  fallback
#
# The profile-driven variables therefore appear below as EMPTY override
# slots. Empty means "unset" — the profile applies. Filling a slot overrides
# the profile deliberately, for all environments.
APP_ENV=dev

# --- Override Slots (leave empty so the profile applies) -------------------
XDEBUG_MODE=
PCOV_ENABLED=
OPCACHE_ENABLE=
OPCACHE_VALIDATE_TIMESTAMPS=
OPCACHE_REVALIDATE_FREQ=
OPCACHE_JIT=
PHP_DISPLAY_ERRORS=
PHP_ERROR_REPORTING=

# -----------------------------------------------------------------------------
# PHP — profile-independent values
# -----------------------------------------------------------------------------
PHP_MEMORY_LIMIT=512M
PHP_TIMEZONE=UTC
PHP_LOG_ERRORS=On

# max_execution_time: a deliberate difference. The reason is the process
# type, not the target:
#   CLI  = long-running worker/consumer, a time limit would be harmful there
#   WEB  = request context (fpm), a limit bounds hanging requests
PHP_MAX_EXECUTION_TIME_CLI=0
PHP_MAX_EXECUTION_TIME_WEB=30

# -----------------------------------------------------------------------------
# APCu
# -----------------------------------------------------------------------------
APCU_SHM_SIZE=64M

# -----------------------------------------------------------------------------
# OPcache & JIT — profile-independent values
# -----------------------------------------------------------------------------
OPCACHE_MEMORY_CONSUMPTION=128
OPCACHE_MAX_ACCELERATED_FILES=4000
OPCACHE_JIT_BUFFER_SIZE=128M

# -----------------------------------------------------------------------------
# Xdebug — profile-independent values
# -----------------------------------------------------------------------------
# Only take effect if XDEBUG_MODE (profile or override) enables Xdebug.
XDEBUG_START_WITH_REQUEST=yes
XDEBUG_CLIENT_HOST=host.docker.internal
XDEBUG_CLIENT_PORT=9003
XDEBUG_LOG_LEVEL=0
XDEBUG_IDEKEY=PHPSTORM

# -----------------------------------------------------------------------------
# PHP-FPM pool (target fpm only)
# -----------------------------------------------------------------------------
FPM_PM=dynamic
FPM_PM_MAX_CHILDREN=5
FPM_PM_START_SERVERS=2
FPM_PM_MIN_SPARE_SERVERS=1
FPM_PM_MAX_SPARE_SERVERS=3
FPM_PM_MAX_REQUESTS=500


# =============================================================================
# Demo stack (tests/demo/demo-stack.yml)
# =============================================================================
# Only the demo stack reads these values; none of them go into the images.
# The credentials are deliberately trivial and in plain text: the stack is a
# demonstration on a developer machine, its database lives in a tmpfs and is
# gone with the container. Anyone using it as a template for real operation
# replaces them — the structure stays the same.
DEMO_DB_NAME=demo
DEMO_DB_USER=demo
DEMO_DB_PASSWORD=demo
DEMO_DB_ROOT_PASSWORD=demo-root

# Host port under which the demo stack becomes reachable: http://localhost:8088
#
# Not 8080: on the development machine, a permanently running host_proxy
# container holds 80, 443, AND 8080. If 8088 is also taken, use
# `make demo-up DEMO_HTTP_PORT=8090` — the error is visible and names the
# port, nothing fails silently.
DEMO_HTTP_PORT=8088
