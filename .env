# =============================================================================
# php-image-builder — Single Source of Truth
# =============================================================================
# Diese Datei speist ALLE Targets (base, cli, fpm) und den
# Demo-Stack. Kein Wert wird an einer zweiten Stelle gepflegt; insbesondere
# traegt kein Dockerfile einen eigenen Versions-Default (A2.4).
#
# Gelesen von:  Makefile (include + export) -> support/docker-bake.hcl -> Dockerfiles
#               docker compose (Demo-Stack)
#
# Quoting: bewusst OHNE Anfuehrungszeichen, weil Make den Wert sonst inklusive
# der Zeichen uebernimmt. Werte mit Leerzeichen werden erst an der
# Verwendungsstelle gequotet.
# =============================================================================


# -----------------------------------------------------------------------------
# Repository & Registry
# -----------------------------------------------------------------------------
GITHUB_ORG=jardisOps
GITHUB_REPO=php-image-builder

DOCKER_HUB=headgent
DOCKER_BUILDKIT=1
MAINTAINER_EMAIL=jardisDev@headgent.com

# Publizierte Image-Namen. Bleiben unveraendert (E2) — der Repo-Name ist davon
# unabhaengig, Konsumenten duerfen die Konsolidierung nicht merken.
IMAGE_NAME_CLI=phpcli
IMAGE_NAME_FPM=phpfpm


# -----------------------------------------------------------------------------
# Basis-Images
# -----------------------------------------------------------------------------
ALPINE_VERSION=3.23

# Default-PHP-Version fuer Einzel-Builds (make build, make shell).
# Die vollstaendige Build-Matrix steht in support/makefiles/docker.helper.mk
# (PHP_VERSIONS): 8.3 / 8.4 / 8.5, inklusive der PHP_LATEST-Ableitung.
# 8.2 wurde am 2026-07-25 auf Anweisung des Users gestrichen.
PHP_VERSION=8.3

# nginx fuer den Demo-Stack. Kein Build-Target mehr (E9) — das offizielle Image
# wird unveraendert verwendet.
NGINX_VERSION=1.28

# Datenbank fuer den Demo-Stack. Ebenfalls ein unveraendertes offizielles Image
# (A8.1) — dieses Repo baut PHP-Laufzeiten, keine Datenbanken (dieselbe Grenze
# wie bei nginx, E9).
#
# 11.8 ist die aktuelle LTS-Reihe. Die Jardis-Projekte pinnen in ihren
# Test-Compose-Dateien noch 11.2; das ist eine kurzlebige Reihe ohne Pflege und
# taugt nicht als Vorlage fuer den Weg, den Projekte gehen sollen.
MARIADB_VERSION=11.8

# FrankenPHP wurde am 2026-07-25 als Build-Target gestrichen (E11) — die
# Schluessel FRANKENPHP_VERSION und IMAGE_NAME_FRANKENPHP sind mit entfallen.
# Was vor der Streichung am Image belegt wurde, steht in der Git-Historie
# (docs/PROGRESS.md, Abschnitt "P7 — entfallen", entfernt beim Aufraeumen der
# Bauunterlagen), damit ein spaeterer Anlauf nicht bei null beginnt.


# -----------------------------------------------------------------------------
# Build-Werkzeuge
# -----------------------------------------------------------------------------
COMPOSER_VERSION=2.9.5

# PECL-Extensions. Identisch fuer alle Targets — die Extension-Liste selbst
# liegt in src/shared/php-extensions.env (A2.2).
APCU_VERSION=5.1.28
REDIS_VERSION=6.3.0
XDEBUG_VERSION=3.5.1
PCOV_VERSION=1.0.12
AMQP_VERSION=2.2.0
RDKAFKA_VERSION=6.0.5

# Optionale DB-CLI-Clients, kommasepariert: mysql,postgres,sqlite
# Leer = keine Clients. Gilt ab base fuer alle Targets (hebt D5 auf).
INSTALL_DB_CLIENTS=


# -----------------------------------------------------------------------------
# Container-Benutzer
# -----------------------------------------------------------------------------
# Basis-UID/GID von appuser, in das Image gebacken. Der Entrypoint passt sie zur
# Laufzeit an den Eigentuemer von /app an (A4); ein Override ist daher selten
# noetig. Unix-Benutzer UND -Gruppe heissen in allen Targets "appuser" (A3.3,
# hebt D7 auf — phpcli nannte die Gruppe bisher "appgroup").
PUID=1000
PGID=1000

APP_ROOT=/app


# =============================================================================
# Laufzeit-Defaults
# =============================================================================

# -----------------------------------------------------------------------------
# APP_ENV — der eine Umgebungsschalter (A10)
# -----------------------------------------------------------------------------
# Gueltige Werte: dev | test | prod
# Setzt ein konsistentes Profil aus Xdebug-, PCOV-, OPcache-, JIT- und
# Fehleranzeige-Einstellungen. Die Profiltabelle liegt an genau einer Stelle:
# src/shared/entrypoint/lib-phpini.sh.
#
# VORRANGREGEL (A10.2):
#   explizit gesetzte Einzelvariable  >  APP_ENV-Profil  >  Fallback
#
# Die profilgesteuerten Variablen stehen deshalb unten als LEERE Override-Slots.
# Leer heisst "nicht gesetzt" — dann greift das Profil. Wer einen Slot fuellt,
# uebersteuert das Profil bewusst und fuer alle Umgebungen.
APP_ENV=dev

# --- Override-Slots (leer lassen, damit das Profil greift) -------------------
XDEBUG_MODE=
PCOV_ENABLED=
OPCACHE_ENABLE=
OPCACHE_VALIDATE_TIMESTAMPS=
OPCACHE_REVALIDATE_FREQ=
OPCACHE_JIT=
PHP_DISPLAY_ERRORS=
PHP_ERROR_REPORTING=

# -----------------------------------------------------------------------------
# PHP — profilunabhaengige Werte
# -----------------------------------------------------------------------------
PHP_MEMORY_LIMIT=512M
PHP_TIMEZONE=UTC
PHP_LOG_ERRORS=On

# max_execution_time: begruendetes Delta (A2.5, hebt D10 als bewussten
# Unterschied auf). Der Grund ist der Prozesstyp, nicht das Target:
#   CLI  = langlaufender Worker/Consumer, ein Zeitlimit ist dort schaedlich
#   WEB  = Request-Kontext (fpm), ein Limit begrenzt haengende Requests
PHP_MAX_EXECUTION_TIME_CLI=0
PHP_MAX_EXECUTION_TIME_WEB=30

# -----------------------------------------------------------------------------
# APCu
# -----------------------------------------------------------------------------
APCU_SHM_SIZE=64M

# -----------------------------------------------------------------------------
# OPcache & JIT — profilunabhaengige Werte
# -----------------------------------------------------------------------------
OPCACHE_MEMORY_CONSUMPTION=128
OPCACHE_MAX_ACCELERATED_FILES=4000
OPCACHE_JIT_BUFFER_SIZE=128M

# -----------------------------------------------------------------------------
# Xdebug — profilunabhaengige Werte
# -----------------------------------------------------------------------------
# Wirken nur, wenn XDEBUG_MODE (Profil oder Override) Xdebug aktiviert.
XDEBUG_START_WITH_REQUEST=yes
XDEBUG_CLIENT_HOST=host.docker.internal
XDEBUG_CLIENT_PORT=9003
XDEBUG_LOG_LEVEL=0
XDEBUG_IDEKEY=PHPSTORM

# -----------------------------------------------------------------------------
# PHP-FPM-Pool (nur Target fpm)
# -----------------------------------------------------------------------------
FPM_PM=dynamic
FPM_PM_MAX_CHILDREN=5
FPM_PM_START_SERVERS=2
FPM_PM_MIN_SPARE_SERVERS=1
FPM_PM_MAX_SPARE_SERVERS=3
FPM_PM_MAX_REQUESTS=500


# =============================================================================
# Demo-Stack (tests/demo/demo-stack.yml, P10)
# =============================================================================
# Nur der Demo-Stack liest diese Werte; in die Images geht keiner davon ein.
# Die Zugangsdaten sind bewusst trivial und stehen im Klartext: der Stack ist
# eine Vorfuehrung auf einem Entwicklerrechner, seine Datenbank liegt in einem
# tmpfs und ist mit dem Container weg. Wer ihn als Vorlage fuer echten Betrieb
# nimmt, ersetzt sie — die Struktur bleibt dieselbe.
DEMO_DB_NAME=demo
DEMO_DB_USER=demo
DEMO_DB_PASSWORD=demo
DEMO_DB_ROOT_PASSWORD=demo-root

# Host-Port, unter dem der Demo-Stack erreichbar wird: http://localhost:8088
#
# Nicht 8080: auf dem Entwicklungsrechner haelt ein dauerhaft laufender
# host_proxy-Container 80, 443 UND 8080 (gemessen 2026-07-26, `make demo-up`
# scheiterte an "port is already allocated"). Ist auch 8088 belegt, hilft
# `make demo-up DEMO_HTTP_PORT=8090` — der Fehler ist sichtbar und benennt den
# Port, es geht nichts still schief.
DEMO_HTTP_PORT=8088
