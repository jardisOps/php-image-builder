# Build context for all targets is the repo root, because base, cli, and fpm
# share access to src/shared/. Anything a target doesn't need is excluded
# here to keep the context small and prevent a careless COPY from pulling
# repo clutter into the image.

# Version control & tooling
.git/
.github/
.gitignore
.dockerignore

# Build control (passed as a build arg, not copied into the image)
# support/ also covers docker-bake.hcl and hadolint.yaml, both located there.
.env
Makefile
support/
tests/
.buildx-cache/

# Documentation (not part of any runtime)
docs/
LICENSE
**/*.md

# Editor & OS
.idea/
.vscode/
.claude/
**/.DS_Store

# Temporary files
**/*.tmp
**/*.log
**/*.cache
*.local
