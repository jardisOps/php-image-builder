# -----------------------------------------------------------------------------
# Defaults fuer templates/default.conf.template (A6.4)
# -----------------------------------------------------------------------------
# Diese Datei ist die einzige Stelle, an der die Vorlagen-Variablen samt
# Default gepflegt sind (A2.1). Sie ist gleichzeitig ihre Dokumentation.
#
# Warum eine Datei und nicht Defaults in der Vorlage: envsubst kennt keine
# Default-Schreibweise. Eine Variable, die in der Umgebung fehlt, bleibt in der
# erzeugten Konfiguration als ${NAME} stehen — nginx bricht dann beim Start ab
# ("unknown ... variable"). Mit dieser Datei laeuft der Stack ohne jede eigene
# Konfiguration.
#
# Verwendung:
#   env_file: [ ./nginx-defaults.env ]   # compose
#   docker run --env-file nginx-defaults.env ...
#
# Vorrang: was in compose unter environment: bzw. per -e gesetzt ist, schlaegt
# diese Datei — dieselbe Richtung wie A10.2 bei den PHP-Werten.
#
# envsubst validiert nichts. Ein Tippfehler landet ungeprueft in der
# Konfiguration; nginx meldet ihn beim Start, wenn er ihn sehen kann
# (REQUEST_SCHEME=htps etwa bleibt unbemerkt und bedeutet dann "kein HTTPS").
# -----------------------------------------------------------------------------

# server_name des vhosts.
HOST=localhost

# Anwendungswurzel im Container und Document-Root darunter. Die Vorlage setzt
# beide zusammen: root ${APP_ROOT}${DOCUMENT_ROOT} — DOCUMENT_ROOT beginnt
# deshalb mit einem Schraegstrich. APP_ROOT deckt sich mit dem Wert der .env
# dieses Repos, damit nginx und die PHP-Container denselben Pfad sehen.
APP_ROOT=/app
DOCUMENT_ROOT=/public

# Front-Controller. Steuert index, try_files und die PATH_INFO-Location.
INDEX_FILE=index.php

# FastCGI-Upstream: Service-Name des php-fpm-Containers und dessen Port.
# Im Bestand war der Host als "app:" hartkodiert (A6.1).
FASTCGI_UPSTREAM=app
PHP_PORT=9000

# Maximale Request-Groesse. War im Bestand hartkodiert (A6.1).
CLIENT_MAX_BODY_SIZE=100m

# FastCGI-Zeitlimits in Sekunden. Waren im Bestand hartkodiert (A6.1).
# READ deckt die Laufzeit des PHP-Requests ab und passt zu einem grosszuegig
# gesetzten PHP_MAX_EXECUTION_TIME_WEB; CONNECT betrifft nur den Verbindungs-
# aufbau zum Upstream.
FASTCGI_READ_TIMEOUT=600
FASTCGI_SEND_TIMEOUT=600
FASTCGI_CONNECT_TIMEOUT=300

# Schema, unter dem die Anwendung nach aussen erreichbar ist: http oder https
# (A6.2). Der eine Schalter setzt HTTPS, REQUEST_SCHEME und
# HTTP_X_FORWARDED_PROTO gemeinsam.
#
#   http   Betrieb ohne vorgelagerten TLS-Proxy. HTTPS wird nicht uebergeben,
#          die Anwendung baut http-URLs. Richtiger Default fuer den
#          Demo-Stack und die lokale Entwicklung.
#   https  Betrieb hinter einem TLS-Proxy (Traefik, nginx-proxy, ALB), der TLS
#          terminiert und per Klartext an diesen vhost weitergibt. Das war der
#          fest verdrahtete Zustand des Bestands.
REQUEST_SCHEME=http
