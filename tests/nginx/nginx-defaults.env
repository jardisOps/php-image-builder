# -----------------------------------------------------------------------------
# Defaults for templates/default.conf.template
# -----------------------------------------------------------------------------
# This file is the single place where the template variables and their
# defaults are maintained, and doubles as their documentation.
#
# Why a file and not defaults in the template: envsubst has no default syntax.
# A variable missing from the environment stays in the generated config as
# ${NAME}, and nginx then fails to start ("unknown ... variable"). With this
# file, the stack runs without any configuration of its own.
#
# Usage:
#   env_file: [ ./nginx-defaults.env ]   # compose
#   docker run --env-file nginx-defaults.env ...
#
# Precedence: whatever compose sets under environment: (or -e) overrides this
# file — same direction as for the PHP values.
#
# envsubst validates nothing. A typo lands in the config unchecked; nginx
# reports it at startup if it can see it at all (REQUEST_SCHEME=htps, for
# example, goes unnoticed and simply means "no HTTPS").
# -----------------------------------------------------------------------------

# server_name of the vhost.
HOST=localhost

# Application root in the container and the document root beneath it. The
# template combines both: root ${APP_ROOT}${DOCUMENT_ROOT} — DOCUMENT_ROOT
# therefore starts with a slash. APP_ROOT matches this repo's .env value so
# nginx and the PHP containers see the same path.
APP_ROOT=/app
DOCUMENT_ROOT=/public

# Front controller. Drives index, try_files and the PATH_INFO location.
INDEX_FILE=index.php

# FastCGI upstream: service name of the php-fpm container and its port.
FASTCGI_UPSTREAM=app
PHP_PORT=9000

# Maximum request size.
CLIENT_MAX_BODY_SIZE=100m

# FastCGI timeouts in seconds. READ covers the runtime of the PHP request and
# should be generous alongside PHP_MAX_EXECUTION_TIME_WEB; CONNECT only
# concerns establishing the connection to the upstream.
FASTCGI_READ_TIMEOUT=600
FASTCGI_SEND_TIMEOUT=600
FASTCGI_CONNECT_TIMEOUT=300

# Scheme under which the application is reachable from outside: http or https.
# The one switch sets HTTPS, REQUEST_SCHEME and HTTP_X_FORWARDED_PROTO
# together.
#
#   http   No upstream TLS proxy. HTTPS is not passed through, the application
#          builds http URLs. The right default for the demo stack and local
#          development.
#   https  Behind a TLS proxy (Traefik, nginx-proxy, ALB) that terminates TLS
#          and forwards to this vhost in plaintext.
REQUEST_SCHEME=http
